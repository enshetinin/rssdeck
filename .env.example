# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
#
# Local development: run `npm run supabase:start`, then copy the API URL and
# keys printed by `npm run supabase:status`.
# Production: set these in the Render dashboard (environment variables / secret
# files), never in the repository.

# Public (safe for the browser) ------------------------------------------------
# Supabase API URL. Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or legacy anon key. Access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server only — NEVER prefix with NEXT_PUBLIC_ ----------------------------------
# Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
# Only needed by the ingestion job (scripts/), not by the web app.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
